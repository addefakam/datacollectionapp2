// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  password        String
  name            String
  role            String   @default("COLLECTOR") // ADMIN or COLLECTOR
  assignedSubCity String? // sub-city assignment for collectors (survey default)
  assignedArea    String? // woreda/area assignment for collectors (survey default)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attendances         Attendance[]
  industryAttendances IndustryAttendance[]
  meetingAssignments  CollectorAssignment[]
}

model GuestHouse {
  id                 String   @id @default(cuid())
  guestHouseName     String
  organizationName   String?
  subCity            String
  area               String
  specificAddress    String
  numberOfRooms      Int
  licenseType        String
  licenseLevel       String
  licenseNumber      String?
  serviceRating      Int
  contactPhone       String?
  contactName        String?
  contactPhone2      String?
  contactName2       String?
  ownerName          String?
  hasRestaurant      Boolean  @default(false)
  hasParking         Boolean  @default(false)
  hasWiFi            Boolean  @default(false)
  hasHotWater        Boolean  @default(false)
  additionalServices String?
  surveyorName       String?
  surveyorId         String?
  signature          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attendances Attendance[]
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  status    String   @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances         Attendance[]
  assignments         CollectorAssignment[]
  industryAttendances IndustryAttendance[]
}

model Attendance {
  id           String   @id @default(cuid())
  meetingId    String
  guestHouseId String
  collectorId  String
  status       String   @default("ABSENT") // PRESENT or ABSENT
  markedAt     DateTime @updatedAt

  meeting    Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  guestHouse GuestHouse @relation(fields: [guestHouseId], references: [id], onDelete: Cascade)
  collector  User       @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([meetingId, guestHouseId]) // one attendance record per guest house per meeting
}

model CollectorAssignment {
  id          String   @id @default(cuid())
  collectorId String
  meetingId   String
  subCity     String
  area        String
  createdAt   DateTime @default(now())

  collector User    @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([collectorId, meetingId, subCity, area]) // no duplicate assignments
}

model Industry {
  id                String   @id @default(cuid())
  establishmentName String
  sector            String
  subCity           String
  area              String
  specificAddress   String
  licenseNumber     String?
  ownershipType     String
  hasEia            Boolean  @default(false) // Environmental Impact Assessment done
  hasEmp            Boolean  @default(false) // Environmental Management Plan prepared
  employeeCount     Int      @default(0)
  maleEmployees     Int      @default(0) // employees by sex: male
  femaleEmployees   Int      @default(0) // employees by sex: female
  startupCapital    Float?
  contactName       String
  contactPhone      String
  surveyorName      String?
  surveyorId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attendances IndustryAttendance[]
}

model IndustryAttendance {
  id          String   @id @default(cuid())
  meetingId   String
  industryId  String
  collectorId String
  status      String   @default("ABSENT") // PRESENT or ABSENT
  markedAt    DateTime @updatedAt

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  industry  Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  collector User     @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([meetingId, industryId]) // one attendance record per industry per meeting
}

model HealthCenter {
  id              String   @id @default(cuid())
  facilityName    String
  facilityType    String // Hospital, Health Center, Private Clinic, ...
  ownershipType   String // Government / Public, Private, NGO, ...
  subCity         String
  area            String
  specificAddress String
  licenseNumber   String?
  staffCount      Int      @default(0) // health professionals & support staff
  maleStaff       Int      @default(0) // staff by sex: male
  femaleStaff     Int      @default(0) // staff by sex: female
  bedCount        Int      @default(0) // inpatient beds (0 for outpatient-only)
  hasLaboratory   Boolean  @default(false) // on-site laboratory service
  hasPharmacy     Boolean  @default(false) // on-site pharmacy service
  hasMaternity    Boolean  @default(false) // maternity / delivery service
  hasEmergency    Boolean  @default(false) // emergency service, open 24/7
  contactName     String
  contactPhone    String
  surveyorName    String?
  surveyorId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Educational institution (Mana Barumsaa) — Bishoftu education survey
model EducationCenter {
  id                String   @id @default(cuid())
  institutionName   String
  institutionType   String // Kindergarten, Primary School, TVET College, ...
  ownershipType     String // Government / Public, Private, Faith-Based, ...
  subCity           String
  area              String
  specificAddress   String
  licenseNumber     String?
  studentCount      Int      @default(0) // total enrolled students
  maleStudents      Int      @default(0) // students by sex: male
  femaleStudents    Int      @default(0) // students by sex: female
  teacherCount      Int      @default(0) // teaching staff
  maleTeachers      Int      @default(0) // teachers by sex: male
  femaleTeachers    Int      @default(0) // teachers by sex: female
  classroomCount    Int      @default(0)
  hasLibrary        Boolean  @default(false) // library / reading room
  hasLaboratory     Boolean  @default(false) // science laboratory
  hasComputerLab    Boolean  @default(false) // computer / ICT lab
  hasFeedingProgram Boolean  @default(false) // school feeding program
  contactName       String
  contactPhone      String
  surveyorName      String?
  surveyorId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Agricultural establishment (Mana Qonnaa) — Bishoftu agriculture survey
model AgricultureCenter {
  id               String   @id @default(cuid())
  farmName         String
  farmType         String // Crop Production, Dairy Farming, Poultry, ...
  ownershipType    String // Private, Cooperative, Government / Public, ...
  subCity          String
  area             String
  specificAddress  String
  licenseNumber    String?
  landSizeHectares Float    @default(0) // total land in hectares
  workerCount      Int      @default(0) // permanent + temporary workers
  maleWorkers      Int      @default(0) // workers by sex: male
  femaleWorkers    Int      @default(0) // workers by sex: female
  hasIrrigation    Boolean  @default(false) // irrigation system
  hasGreenhouse    Boolean  @default(false) // greenhouse / protected farming
  hasMachinery     Boolean  @default(false) // tractors & farm machinery
  hasStorage       Boolean  @default(false) // on-site storage facility
  contactName      String
  contactPhone     String
  surveyorName     String?
  surveyorId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Small enterprise (MSE — Micro & Small Enterprise) — Dhibayyuu initiative survey.
// Status follows the establishment lifecycle tracked by the registration &
// performance monitoring module: registered → fully legalized → awaiting
// operation → operational.
model SmallEnterprise {
  id              String    @id @default(cuid())
  enterpriseName  String
  enterpriseType  String // Manufacturing, Construction, Retail Trade, Services, ...
  ownershipType   String // Private, Cooperative, Government / Public, NGO, ...
  subCity         String
  area            String
  specificAddress String
  licenseNumber   String?
  employeeCount   Int       @default(0) // total members / employees of the SME
  maleEmployees   Int       @default(0) // employees by sex: male
  femaleEmployees Int       @default(0) // employees by sex: female
  startupCapital  Float? // start-up / working capital in ETB
  hasPremises     Boolean   @default(false) // has own working premises / space
  hasTraining     Boolean   @default(false) // received MSE training or business support
  status          String    @default("REGISTERED") // REGISTERED | FULLY_LEGALIZED | AWAITING_OPERATION | OPERATIONAL
  statusUpdatedAt DateTime? // when the establishment status last changed
  statusNote      String? // optional note recorded with the latest status change
  contactName     String
  contactPhone    String
  surveyorName    String?
  surveyorId      String?
  customAnswers   Json? // answers to admin-added custom questionnaire questions (key = "custom_*")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([subCity, area])
}

// Bussa Goonofa / Charity initiative — charitable organizations serving the
// sub-city (NGOs, Iddir / community charities, faith-based, private charities).
model CharityInitiative {
  id                   String   @id @default(cuid())
  organizationName     String
  organizationType     String // Local NGO, International NGO, Community-Based (Iddir), Faith-Based, ...
  charityType          String // Orphan Support, Elderly Care, Health Support, Education Support, ...
  subCity              String
  area                 String
  specificAddress      String
  registrationNumber   String? // legal registration / license number (optional)
  beneficiaryCount     Int      @default(0) // people served
  maleBeneficiaries    Int      @default(0) // beneficiaries by sex: male
  femaleBeneficiaries  Int      @default(0) // beneficiaries by sex: female
  volunteerCount       Int      @default(0) // active volunteers
  annualBudget         Float? // annual operating budget in ETB
  hasLegalRegistration Boolean  @default(false) // registered with the concerned authority
  contactName          String
  contactPhone         String
  surveyorName         String?
  surveyorId           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Small Enterprise (MSE) establishment target set at city, sub-city or woreda
// level. The city sets the overall establishment target; sub-cities distribute
// theirs across their woredas; performance (registered vs target, achievement
// rate, pending and operational progress) is computed live from the
// SmallEnterprise records per administrative level.
model SmeTarget {
  id            String   @id @default(cuid())
  level         String // CITY | SUB_CITY | WOREDA
  subCity       String   @default("") // sub-city name (SUB_CITY / WOREDA), "" for city-wide
  area          String   @default("") // woreda name (WOREDA), "" otherwise
  periodType    String // monthly | quarterly | yearly
  periodStart   DateTime // inclusive start of the target period
  periodEnd     DateTime // inclusive end of the target period
  targetValue   Int // number of SMEs to be established in the scope + period
  note          String?
  status        String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([level, subCity, area, periodType, periodStart])
  @@index([level, subCity, area, status])
}

// Official goal/target set on an initiative metric for a weekly, monthly or yearly
// period — progress is computed live from the recorded survey data.
model Goal {
  id          String   @id @default(cuid())
  module      String   @default("small-enterprise") // which initiative the goal belongs to
  metric      String // enterprises | employees | femaleEmployees | capital (see src/lib/goals.ts)
  periodType  String // weekly | monthly | yearly
  periodStart DateTime // inclusive start of the target period
  periodEnd   DateTime // inclusive end of the target period
  targetValue Float
  owner       String? // responsible office / official
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ Initiative Implementation & Performance Monitoring ============
// Lets each sub-city register initiatives, set quantitative targets for the
// responsible departments, receive the departments' daily achievement reports
// and follow every initiative from establishment until it is fully
// operational. Target-vs-actual attainment, performance gaps, delays and
// completion rates are computed from these rows in real time.

// A sub-city office / responsible department (e.g. Health Office, Water &
// Energy Office) that initiatives are assigned to and that submits the daily
// achievement reports.
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  initiatives Initiative[]

  campaignAssignments DonationCampaignAssignment[]
  donationEntries     DonationEntry[]
}

// One monitored initiative / project, from establishment until it becomes
// fully operational. Status follows the follow-up lifecycle.
model Initiative {
  id                      String     @id @default(cuid())
  name                    String
  description             String?
  category                String // Infrastructure, Social Services, Economic Development, Environment, Governance, Other
  departmentId            String
  department              Department @relation(fields: [departmentId], references: [id])
  subCity                 String
  area                    String?
  status                  String     @default("PROPOSED") // PROPOSED | APPROVED | IN_PROGRESS | FULLY_OPERATIONAL | ON_HOLD | CANCELLED
  establishmentDate       DateTime? // when the initiative was established / started
  expectedOperationalDate DateTime? // planned date to be fully operational (deadline)
  operationalDate         DateTime? // when it actually became fully operational
  location                String?
  contactName             String?
  contactPhone            String?
  surveyorName            String? // registered by
  surveyorId              String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  targets      InitiativeTarget[]
  dailyReports InitiativeDailyReport[]
}

// A quantitative target set by the sub-city on an initiative metric for the
// responsible department — e.g. "10 km of road, total, due 2027-03-31".
model InitiativeTarget {
  id           String     @id @default(cuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  metric       String // what is measured, e.g. "Road constructed"
  unit         String? // households, km, students, ETB, %, ...
  targetValue  Float
  periodType   String     @default("total") // daily | weekly | monthly | quarterly | yearly | total (project lifetime)
  dueDate      DateTime? // when the target value must be reached
  status       String     @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  dailyReports InitiativeDailyReport[]
}

// The department's daily achievement report for one initiative — the daily
// activity log the sub-city monitors. One report per initiative per day;
// re-submitting the same day updates it.
model InitiativeDailyReport {
  id             String            @id @default(cuid())
  initiativeId   String
  initiative     Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  targetId       String? // which target the achieved value counts toward (optional)
  target         InitiativeTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  reportDate     DateTime // the day being reported (UTC midnight)
  activities     String // what was done that day (daily activity monitoring)
  achievedValue  Float? // quantity achieved that day against the selected target
  challenges     String?
  supportNeeded  String?
  reportedById   String? // who submitted (User id, no FK — surveyor convention)
  reportedByName String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([initiativeId, reportDate]) // one daily report per initiative per day
}

// ============ Bussa Goonofaa Charity — Donation Campaign Automation ============
// The charity coordination office sets one campaign goal, distributes it as a
// minimum collection amount across the responsible offices (tourism, land
// management, ...), receives each office's donation achievement reports
// (cash + in-kind) and presents the office-wise goal report to higher
// officials. Attainment, pace and gaps are computed live from these rows.

// One donation campaign: the overall goal the charity office must mobilize
// (cash donations plus the estimated value of in-kind donations).
model DonationCampaign {
  id            String   @id @default(cuid())
  name          String
  description   String?
  totalGoal     Float // overall minimum amount to collect (ETB)
  currency      String   @default("ETB")
  kindNote      String? // what in-kind donations are expected (food grains, clothes, ...)
  startDate     DateTime
  deadline      DateTime
  status        String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments DonationCampaignAssignment[]
  donations   DonationEntry[]
}

// Distribution of the campaign goal to one responsible office: the minimum
// amount that office must collect during the campaign.
model DonationCampaignAssignment {
  id            String           @id @default(cuid())
  campaignId    String
  campaign      DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department       @relation(fields: [departmentId], references: [id])
  minimumAmount Float
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([campaignId, departmentId])
}

// One office's achievement record: the donations it received on a day —
// cash amount plus in-kind contributions and their estimated value.
model DonationEntry {
  id             String           @id @default(cuid())
  campaignId     String
  campaign       DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department       @relation(fields: [departmentId], references: [id])
  reportDate     DateTime
  cashAmount     Float            @default(0)
  inKindValue    Float            @default(0)
  inKindDetails  String? // what was donated in kind (e.g. "15 quintals teff, 20 blankets")
  donorsCount    Int              @default(0)
  notes          String?
  reportedById   String?
  reportedByName String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([campaignId, departmentId, reportDate])
}

// Admin-managed locations (sub-cities + woredas/areas) used across all survey forms
model SubCity {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas SubCityArea[]
}

model SubCityArea {
  id        String @id @default(cuid())
  subCityId String
  name      String
  sortOrder Int    @default(0)

  subCity SubCity @relation(fields: [subCityId], references: [id], onDelete: Cascade)

  @@unique([subCityId, name])
}

// Admin-managed industry categories (sectors) used in the industry survey
model IndustryCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Simple key-value store for app-wide configuration (admin editable),
// e.g. which attribute the Sector Distribution stats group by.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
