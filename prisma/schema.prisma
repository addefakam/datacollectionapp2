// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  password       String
  name           String
  role           String   @default("COLLECTOR") // ADMIN or COLLECTOR
  assignedSubCity String? // sub-city assignment for collectors (survey default)
  assignedArea   String?  // woreda/area assignment for collectors (survey default)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances       Attendance[]
  industryAttendances IndustryAttendance[]
  meetingAssignments CollectorAssignment[]
}

model GuestHouse {
  id               String   @id @default(cuid())
  guestHouseName   String
  organizationName String?
  subCity          String
  area             String
  specificAddress  String
  numberOfRooms    Int
  licenseType      String
  licenseLevel     String
  licenseNumber    String?
  serviceRating    Int
  contactPhone     String?
  contactName      String?
  contactPhone2    String?
  contactName2     String?
  ownerName        String?
  hasRestaurant    Boolean  @default(false)
  hasParking       Boolean  @default(false)
  hasWiFi          Boolean  @default(false)
  hasHotWater      Boolean  @default(false)
  additionalServices String?
  surveyorName     String?
  surveyorId       String?
  signature        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendances Attendance[]
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  status    String   @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]
  assignments  CollectorAssignment[]
  industryAttendances IndustryAttendance[]
}

model Attendance {
  id           String   @id @default(cuid())
  meetingId    String
  guestHouseId String
  collectorId  String
  status       String   @default("ABSENT") // PRESENT or ABSENT
  markedAt     DateTime @updatedAt

  meeting    Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  guestHouse GuestHouse @relation(fields: [guestHouseId], references: [id], onDelete: Cascade)
  collector  User       @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([meetingId, guestHouseId]) // one attendance record per guest house per meeting
}

model CollectorAssignment {
  id          String   @id @default(cuid())
  collectorId String
  meetingId   String
  subCity     String
  area        String
  createdAt   DateTime @default(now())

  collector User    @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([collectorId, meetingId, subCity, area]) // no duplicate assignments
}

model Industry {
  id                String   @id @default(cuid())
  establishmentName String
  sector            String
  subCity           String
  area              String
  specificAddress   String
  licenseNumber     String?
  ownershipType     String
  hasEia            Boolean  @default(false) // Environmental Impact Assessment done
  hasEmp            Boolean  @default(false) // Environmental Management Plan prepared
  employeeCount     Int      @default(0)
  startupCapital    Float?
  contactName       String
  contactPhone      String
  surveyorName      String?
  surveyorId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attendances IndustryAttendance[]
}

model IndustryAttendance {
  id          String   @id @default(cuid())
  meetingId   String
  industryId  String
  collectorId String
  status      String   @default("ABSENT") // PRESENT or ABSENT
  markedAt    DateTime @updatedAt

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  industry  Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  collector User     @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([meetingId, industryId]) // one attendance record per industry per meeting
}

model HealthCenter {
  id              String   @id @default(cuid())
  facilityName    String
  facilityType    String // Hospital, Health Center, Private Clinic, ...
  ownershipType   String // Government / Public, Private, NGO, ...
  subCity         String
  area            String
  specificAddress String
  licenseNumber   String?
  staffCount      Int      @default(0) // health professionals & support staff
  bedCount        Int      @default(0) // inpatient beds (0 for outpatient-only)
  hasLaboratory   Boolean  @default(false) // on-site laboratory service
  hasPharmacy     Boolean  @default(false) // on-site pharmacy service
  hasMaternity    Boolean  @default(false) // maternity / delivery service
  hasEmergency    Boolean  @default(false) // emergency service, open 24/7
  contactName     String
  contactPhone    String
  surveyorName    String?
  surveyorId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Educational institution (Mana Barumsaa) — Bishoftu education survey
model EducationCenter {
  id                String   @id @default(cuid())
  institutionName   String
  institutionType   String // Kindergarten, Primary School, TVET College, ...
  ownershipType     String // Government / Public, Private, Faith-Based, ...
  subCity           String
  area              String
  specificAddress   String
  licenseNumber     String?
  studentCount      Int      @default(0) // total enrolled students
  teacherCount      Int      @default(0) // teaching staff
  classroomCount    Int      @default(0)
  hasLibrary        Boolean  @default(false) // library / reading room
  hasLaboratory     Boolean  @default(false) // science laboratory
  hasComputerLab    Boolean  @default(false) // computer / ICT lab
  hasFeedingProgram Boolean  @default(false) // school feeding program
  contactName       String
  contactPhone      String
  surveyorName      String?
  surveyorId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Agricultural establishment (Mana Qonnaa) — Bishoftu agriculture survey
model AgricultureCenter {
  id              String   @id @default(cuid())
  farmName        String
  farmType        String // Crop Production, Dairy Farming, Poultry, ...
  ownershipType   String // Private, Cooperative, Government / Public, ...
  subCity         String
  area            String
  specificAddress String
  licenseNumber   String?
  landSizeHectares Float  @default(0) // total land in hectares
  workerCount     Int      @default(0) // permanent + temporary workers
  hasIrrigation   Boolean  @default(false) // irrigation system
  hasGreenhouse   Boolean  @default(false) // greenhouse / protected farming
  hasMachinery    Boolean  @default(false) // tractors & farm machinery
  hasStorage      Boolean  @default(false) // on-site storage facility
  contactName     String
  contactPhone    String
  surveyorName    String?
  surveyorId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Admin-managed locations (sub-cities + woredas/areas) used across all survey forms
model SubCity {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  areas SubCityArea[]
}

model SubCityArea {
  id        String @id @default(cuid())
  subCityId String
  name      String
  sortOrder Int    @default(0)

  subCity SubCity @relation(fields: [subCityId], references: [id], onDelete: Cascade)

  @@unique([subCityId, name])
}

// Admin-managed industry categories (sectors) used in the industry survey
model IndustryCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Simple key-value store for app-wide configuration (admin editable),
// e.g. which attribute the Sector Distribution stats group by.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
